SECRET_KEY=your-secret-key
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
IS_SIGNUP_DISABLED=False

# Database
POSTGRES_HOST=host
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RECYCLE=1800

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notes attachments (local or s3)
ATTACHMENTS_STORAGE=local
ATTACHMENTS_LOCAL_ROOT=./data/attachments
ATTACHMENTS_MAX_FILE_SIZE_MB=10
ATTACHMENTS_MAX_IMAGE_PIXELS=25000000
ATTACHMENTS_MAX_USER_STORAGE_MB=1024
ATTACHMENTS_MAX_PER_NOTE=100
ATTACHMENTS_UNUSED_TTL_DAYS=7

# S3-compatible storage: set bucket and optionally endpoint for a non-AWS provider
# ATTACHMENTS_S3_BUCKET=perga
# ATTACHMENTS_S3_ENDPOINT_URL=https://s3.example.com
# ATTACHMENTS_S3_REGION=us-east-1
# ATTACHMENTS_S3_ADDRESSING_STYLE=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
